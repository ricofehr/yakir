global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http-in
    bind *:80
    default_backend servers_http

frontend https-in
    bind *:443
    default_backend servers_https

# Git over SSH to the factory's GitLab. Not 22: the managers' own sshd is there.
frontend gitlab-ssh
    bind *:2222
    # A large fetch can pack for minutes before the first byte, and a session
    # may idle; the 50s defaults above would cut both.
    timeout client 1h
    default_backend servers_gitlab_ssh

backend servers_http
    mode tcp
    server server1 {{ haproxy_ip }}:{{ haproxy_http_fw_port }} check

backend servers_https
    mode tcp
    server server1 {{ haproxy_ip }}:{{ haproxy_https_fw_port }} check

backend servers_gitlab_ssh
    mode tcp
    timeout server 1h
    server server1 {{ haproxy_ip }}:{{ haproxy_ssh_fw_port }} check
