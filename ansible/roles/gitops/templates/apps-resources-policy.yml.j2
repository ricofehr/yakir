{#- What an app namespace may hold, whoever writes it: one box runs everything,
    and the platform's traffic passes through the same Traefik and kube-proxy.
    One policy per kind, so each expression is type-checked against that kind
    only. -#}
{% macro match_app_namespaces() %}
  matchConditions:
    - name: in-a-factory-app-namespace
      expression: >-
        {% for pattern in gitops_apps_namespaces %}request.namespace.startsWith("{{ pattern | replace('*', '') }}"){{ " || " if not loop.last else "" }}{% endfor %}

{% endmacro %}
{% macro binding(name) %}
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: {{ name }}
spec:
  policyName: {{ name }}
  validationActions: ["Deny"]
{% endmacro %}
# A ResourceQuota within gitops_apps_quota_max, unscoped; the quota-required
# policy makes one mandatory. spec.hard is a map of quantities, which the type
# checker cannot model, hence dyn().
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: factory-apps-quotas
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["resourcequotas"]
{{ match_app_namespaces() }}  variables:
    - name: max
      expression: '{{ gitops_apps_quota_max | to_json }}'
  validations:
    - expression: >-
        !has(object.spec.scopes) && !has(object.spec.scopeSelector)
        && dyn(object).spec.?hard.orValue({}).all(k, k in variables.max
          && quantity(dyn(object).spec.hard[k]).compareTo(quantity(variables.max[k])) <= 0)
      message: >-
        A factory app quota may not be scoped, and may only set {{ gitops_apps_quota_max.keys() | join(", ") }}, at most {{ gitops_apps_quota_max | to_json }}.
{{ binding("factory-apps-quotas") }}
---
# No positive priority, which would let app pods preempt the platform. The
# resolved priority, not the class name: the Priority admission plugin fills in
# a globalDefault class before this runs.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: factory-apps-pods
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["pods"]
{{ match_app_namespaces() }}  validations:
    - expression: object.spec.?priority.orValue(0) <= 0
      message: Factory app pods may not have a positive priority.
{{ binding("factory-apps-pods") }}
---
# ClusterIP Services only: no external IPs (CVE-2020-8554), no node,
# load-balancer or external-name exposure.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: factory-apps-services
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE", "UPDATE"]
        resources: ["services"]
{{ match_app_namespaces() }}  validations:
    - expression: >-
        !has(object.spec.externalIPs) && object.spec.?type.orValue("ClusterIP") == "ClusterIP"
      message: Factory app Services must be ClusterIP, with no external IPs.
{{ binding("factory-apps-services") }}
---
# No Traefik or Gateway API objects: routing outside a plain Ingress, which the
# hosts policies do not see.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: factory-apps-routing
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: ["traefik.io", "traefik.containo.us", "gateway.networking.k8s.io"]
        apiVersions: ["*"]
        operations: ["CREATE", "UPDATE"]
        resources: ["*"]
{{ match_app_namespaces() }}  validations:
    - expression: "false"
      message: Factory app namespaces may not hold Traefik or Gateway API objects; use the app chart's Ingress.
{{ binding("factory-apps-routing") }}
