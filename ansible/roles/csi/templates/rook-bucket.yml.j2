apiVersion: ceph.rook.io/v1
kind: CephObjectStore
metadata:
  name: my-store
  namespace: {{ csi_rook_namespace }}
spec:
  metadataPool:
    failureDomain: host
    replicated:
      size: 3
  dataPool:
    failureDomain: host
    erasureCoded:
      dataChunks: 2
      codingChunks: 1
  preservePoolsOnDelete: true
  # Namespaces besides this one where CephObjectStoreUsers may be created, so a
  # workload gets its S3 keys as a Secret in its own namespace.
  allowUsersInNamespaces: {{ csi_rook_object_user_namespaces | to_json }}
  gateway:
    sslCertificateRef:
    port: 80
    # securePort: 443
    instances: 1
---
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
   name: rook-ceph-bucket
# Change "rook-ceph" provisioner prefix to match the operator namespace if needed
provisioner: {{ csi_rook_namespace }}.ceph.rook.io/bucket
reclaimPolicy: Delete
parameters:
  # The store above. It used to name a store that does not exist, so every
  # bucket claim waited for ever.
  objectStoreName: my-store
  objectStoreNamespace: {{ csi_rook_namespace }}

