#!/bin/bash -e

declare PROVIDER="virtualbox"
declare -i ISDESTROY=0
declare SIZING="small"
declare K8S_DOMAIN="k8s.local"
declare MIRROR_REGISTRY=""
declare MIRROR_APT=""
declare MIRROR_PYPI=""
declare -a MIRROR_PARAMS=()
declare BACKUP_SERVER_URL=""
declare BACKUP_ACCESS_KEY=""
declare BACKUP_ACCESS_SECRET=""
declare BACKUP_REGION="minio"
declare LINUX_ARCH="amd64"
declare CNI_PLUGIN="calico"
declare CSI_PLUGIN="none"
declare ANSIBLE_TAG=""
declare -a ANSIBLE_TAG_PARAM=()
declare CERT_ISSUER="my-ca-issuer"
declare GITOPS_REPO=""
declare GITOPS_BRANCH="main"
declare GITOPS_SSH_KEY=""
declare -a GITOPS_PARAMS=()
declare LLAMA_API_KEY=""
declare GITHUB_TOKEN=""
declare GITLAB_BACKUP_PASSPHRASE_FILE=""
declare MINIO_ADMIN_CREDENTIALS_FILE=""
declare SSH_PARAMS="-C -o ControlMaster=auto -o ControlPersist=60s -o ConnectTimeout=30 -o ConnectionAttempts=5 -o StrictHostKeyChecking=no"
declare KEEPALIVED_PASSWORD=""
KEEPALIVED_PASSWORD="$(LC_ALL=C tr -dc A-Za-z0-9 </dev/urandom | head -c 8 ; echo '')"

# Help function
deployhelp() {
  cat <<EOF
Usage: $0 [options]
-h                                this is some help text.
-d                                destroy all previously provisioned vms
-c xxxx                           CNI plugin, choices are weave, flannel, calico (default), cilium
-p xxxx                           vagrant provider, default is virtualbox
-s xxxx                           sizing deployment, default is small
                                  - small : 1 manager and 1 nodes, host with 8Go ram / 2 cores
                                  - medium : 3 managers and 2 nodes host with 16Go ram / 4 cores
                                  - large : 3 managers and 5 nodes, host with 24Go ram / 6 cores
-t xxxx                           ansible tag, default is none
--keepalived-password xxxx        keepalived password, default is randomly generated
--kube-domain xxxx                global kubernetes domain, default is $K8S_DOMAIN
--container-registry-mirror xxxx  container private mirror registry
--apt-repository-mirror xxxx      mirror repository URL for apt packages
--pypi-repository-mirror xxxx     mirror repository URL for pypi packages
--cert-issuer-type xxxx           Issuer for managing SSL certs, choices are my-ca-issuer (default), letsencrypt-staging, letsencrypt-prod
--backup-server xxxx              External S3 Server (MinIO / AWS S3) URL
--backup-access-key xxxx          S3 Access Key Id
--backup-access-secret xxxx       S3 Access Key Secret
--backup-region xxxx              S3 Bucket Region, default is $BACKUP_REGION
--gitops-repo xxxx                ai-factory git repository url; enables the gitops role when set
--gitops-branch xxxx              ai-factory git branch, default is $GITOPS_BRANCH
--gitops-ssh-key xxxx             private deploy key for the ai-factory repository
--llama-api-key xxxx              api key of the llama-server backing the LLM gateway
--github-token xxxx               GitHub personal access token for the MCP gateway and context graph
--gitlab-backup-passphrase-file xxxx
                                  file holding the passphrase GitLab's off-site rails-secret copies are encrypted with
--minio-admin-credentials-file xxxx
                                  yaml file (accessKey, secretKey) of a MinIO admin, to set up GitLab's off-site store
EOF

exit 1
}

# Parse cmd options
while (($# > 0)); do
  case "$1" in
    -d)
      shift
      ISDESTROY=1
      ;;
    -c)
      shift
      CNI_PLUGIN="$1"
      shift
      ;;
    --cert-issuer-type)
      shift
      if [[ "$1" = "letsencrypt-staging" ]]; then
        CERT_ISSUER="$1"
      fi
      if [[ "$1" = "letsencrypt-prod" ]]; then
        CERT_ISSUER="$1"
      fi
      shift
      ;;
    --keepalived-password)
      shift
      KEEPALIVED_PASSWORD="$1"
      shift
      ;;
    --kube-domain)
      shift
      K8S_DOMAIN="$1"
      shift
      ;;
    --container-registry-mirror)
      shift
      MIRROR_REGISTRY="$1"
      shift
      ;;
    --apt-repository-mirror)
      shift
      MIRROR_APT="$1"
      shift
      ;;
    --pypi-repository-mirror)
      shift
      MIRROR_PYPI="$1"
      shift
      ;;
    --backup-server)
      shift
      BACKUP_SERVER_URL="$1"
      shift
      ;;
    --backup-access-key)
      shift
      BACKUP_ACCESS_KEY="$1"
      shift
      ;;
    --backup-access-secret)
      shift
      BACKUP_ACCESS_SECRET="$1"
      shift
      ;;
    --backup-region)
      shift
      BACKUP_REGION="$1"
      shift
      ;;
    --gitops-repo)
      shift
      GITOPS_REPO="$1"
      shift
      ;;
    --gitops-branch)
      shift
      GITOPS_BRANCH="$1"
      shift
      ;;
    --gitops-ssh-key)
      shift
      GITOPS_SSH_KEY="$1"
      shift
      ;;
    --llama-api-key)
      shift
      LLAMA_API_KEY="$1"
      shift
      ;;
    --github-token)
      shift
      GITHUB_TOKEN="$1"
      shift
      ;;
    --gitlab-backup-passphrase-file)
      shift
      GITLAB_BACKUP_PASSPHRASE_FILE="$1"
      shift
      ;;
    --minio-admin-credentials-file)
      shift
      MINIO_ADMIN_CREDENTIALS_FILE="$1"
      shift
      ;;
    -s)
      shift
      SIZING="$1"
      shift
      ;;
    -p)
      shift
      PROVIDER="$1"
      shift
      ;;
    -t)
      shift
      ANSIBLE_TAG="$1"
      shift
      ;;
    -h)
      shift
      deployhelp
      ;;
    *)
      shift
      deployhelp
      ;;
  esac
done

# Ensure valid sizing
[[ -f "vagrantfiles/Vagrantfile_${SIZING}" ]] || SIZING="small"

# Check the off-site store's files here, before anything is built. The gitops
# role is the very last thing the playbook runs, so a typo in a path or a
# missing companion flag would otherwise cost a full cluster build to discover.
for offsite_file in "$GITLAB_BACKUP_PASSPHRASE_FILE" "$MINIO_ADMIN_CREDENTIALS_FILE"; do
  if [[ -n "$offsite_file" && ! -r "$offsite_file" ]]; then
    echo "cannot read $offsite_file"
    deployhelp
  fi
done
if [[ -n "$GITLAB_BACKUP_PASSPHRASE_FILE$MINIO_ADMIN_CREDENTIALS_FILE" ]]; then
  if [[ -z "$GITOPS_REPO" || -z "$BACKUP_SERVER_URL" \
        || -z "$GITLAB_BACKUP_PASSPHRASE_FILE" || -z "$MINIO_ADMIN_CREDENTIALS_FILE" ]]; then
    echo "GitLab's off-site store needs --gitops-repo, --backup-server, --gitlab-backup-passphrase-file and --minio-admin-credentials-file together"
    deployhelp
  fi
fi

# Check if we are in arm system
arch_system="$(uname -m)"
if [[ "$arch_system" = "arm64" ]]; then
  LINUX_ARCH="arm64"
fi

if [[ "$arch_system" = "aarch64" ]]; then
  LINUX_ARCH="arm64"
fi

# Enable rook CSI if at least 3 workers
[[ $SIZING = "small" ]] || CSI_PLUGIN="rook"

# Clean older bootstrap
if ((ISDESTROY == 1)); then
  vagrant destroy -f || echo "No vms previously installed"
fi

# Launch vagrant vms
ln -sf "vagrantfiles/Vagrantfile_${SIZING}" Vagrantfile
if [[ "$PROVIDER" = "virtualbox" ]]; then
  export VAGRANT_EXPERIMENTAL="disks"
fi
vagrant up --provider="$PROVIDER"
sleep 15

# Disable cowsay ansible output
export ANSIBLE_NOCOWS=1

mkdir -p tmp

# Define mirrors parameter for Ansible
# Arrays, not strings: these carry operator-supplied secrets, and the command
# below used to run through eval. A value holding a space, a glob character or
# a $ was silently split, expanded or truncated on its way to ansible.
[[ -n "$MIRROR_REGISTRY" ]] && MIRROR_PARAMS+=(-e "crio_mirror=$MIRROR_REGISTRY")

[[ -n "$MIRROR_APT" ]] && MIRROR_PARAMS+=(-e "internal_repos_apt=$MIRROR_APT")

[[ -n "$MIRROR_PYPI" ]] && MIRROR_PARAMS+=(-e "internal_repos_pypi=$MIRROR_PYPI")

# Define gitops parameters. Without --gitops-repo the playbook skips the role.
if [[ -n "$GITOPS_REPO" ]]; then
  GITOPS_PARAMS+=(-e "gitops_repo_url=$GITOPS_REPO" -e "gitops_repo_branch=$GITOPS_BRANCH")
fi
[[ -n "$GITOPS_SSH_KEY" ]] && GITOPS_PARAMS+=(-e "gitops_repo_ssh_key=$GITOPS_SSH_KEY")
[[ -n "$LLAMA_API_KEY" ]] && GITOPS_PARAMS+=(-e "gitops_llama_api_key=$LLAMA_API_KEY")
[[ -n "$GITHUB_TOKEN" ]] && GITOPS_PARAMS+=(-e "gitops_github_token=$GITHUB_TOKEN")
# Only the path travels as an extra var; the passphrase itself never enters argv
# or shell history. Same reason --gitops-ssh-key takes a path rather than a value.
[[ -n "$GITLAB_BACKUP_PASSPHRASE_FILE" ]] && GITOPS_PARAMS+=(-e "gitops_gitlab_backup_passphrase_file=$GITLAB_BACKUP_PASSPHRASE_FILE")
[[ -n "$MINIO_ADMIN_CREDENTIALS_FILE" ]] && GITOPS_PARAMS+=(-e "gitops_minio_admin_credentials_file=$MINIO_ADMIN_CREDENTIALS_FILE")

# Define Ansible tag parameter
[[ -n "$ANSIBLE_TAG" ]] && ANSIBLE_TAG_PARAM+=(-t "$ANSIBLE_TAG")

# Install ansible
rm -rf venv
python3 -mvenv venv
source venv/bin/activate
pip3 install -r requirements.txt

# Launch ansible
pushd ansible >/dev/null

# Prepare inventory and sizing context
ln -sf "inventories/inventory_${SIZING}" inventory
ln -sf "sizing_vars/sizing_vars_${SIZING}.yml" sizing_vars.yml

# Download Ansible Collections
mkdir -p collections/ansible_collections
ansible-galaxy collection install -r requirements.yml -p ./collections/

# Launch Ansible
ansible-playbook --ssh-extra-args="$SSH_PARAMS" -e "global_cert_issuer=$CERT_ISSUER" \
  -e "cni_plugin=$CNI_PLUGIN" -e "keepalived_pass=$KEEPALIVED_PASSWORD" \
  -e "backup_s3_url=$BACKUP_SERVER_URL" -e "backup_s3_accesskey_id=$BACKUP_ACCESS_KEY" \
  -e "backup_s3_accesskey_secret=$BACKUP_ACCESS_SECRET" -e "backup_s3_region=$BACKUP_REGION" \
  -e "global_linux_arch=$LINUX_ARCH" -e "global_domain=$K8S_DOMAIN" -e "csi_plugin=$CSI_PLUGIN" \
  -e "csi_rook_disk=sdb" \
  "${MIRROR_PARAMS[@]}" "${GITOPS_PARAMS[@]}" "${ANSIBLE_TAG_PARAM[@]}" \
  -i inventory playbook.yml 2>&1
popd >/dev/null
