#!/bin/bash -e

# Default parameters value
declare CNI_PLUGIN="flannel"
declare CSI_PLUGIN="rook"
declare SSHKEYFILE="${HOME}/.ssh/id_rsa.pub"
declare ANSIBLEPATH="/usr/bin/ansible-playbook"
declare VM_ETH="eth0"
declare K8S_DOMAIN="kubernetes.local"
declare MIRROR_REGISTRY=""
declare MIRROR_APT=""
declare MIRROR_PYPI=""
declare -a MIRROR_PARAMS=()
declare BACKUP_SERVER_URL=""
declare BACKUP_ACCESS_KEY=""
declare BACKUP_ACCESS_SECRET=""
declare BACKUP_REGION="minio"
declare SIZING="large"
# Documentation addresses (RFC 5737): set --failover-ip, --manager-ips and
# --node-ips to the addresses your DHCP server reserves for the VMs' MACs.
declare VIP_MANAGERS="192.0.2.250"
declare SSH_PARAMS="-C -o ControlMaster=auto -o ControlPersist=60s -o ConnectTimeout=30 -o ConnectionAttempts=5 -o StrictHostKeyChecking=no"
declare MANAGER_IPS="192.0.2.210,192.0.2.211,192.0.2.212"
declare NODE_IPS="192.0.2.220,192.0.2.221,192.0.2.222,192.0.2.223,192.0.2.224"
declare CERTISSUER="my-selfsigned-ca"
declare GITOPS_REPO=""
declare GITOPS_BRANCH="main"
declare GITOPS_SSH_KEY=""
declare -a GITOPS_PARAMS=()
declare LLAMA_API_KEY=""
declare GITHUB_TOKEN=""
declare GITLAB_BACKUP_PASSPHRASE_FILE=""
declare MINIO_ADMIN_CREDENTIALS_FILE=""
declare ANSIBLE_TAGS=""
declare -a ANSIBLE_TAGS_PARAM=()


# Help function
deployhelp() {
  cat <<EOF
Usage: $0 [options]
-h                                this is some help text.
-c xxx                            CNI plugin, choices are cilium / weave / flannel, default is $CNI_PLUGIN
--failover-ip xxxx                failover ip for managers nodes, default is $VIP_MANAGERS
--manager-ips a,b,c               the three managers' addresses, default is $MANAGER_IPS
--node-ips a,b,c,d,e              the five workers' addresses, default is $NODE_IPS
--ansible-path xxxx               override ansible path
--keepalived-password xxxx        keepalived password, default is randomly generated
--kube-domain xxxx                global kubernetes domain, default is $K8S_DOMAIN
--container-registry-mirror xxxx  container private mirror registry
--apt-repository-mirror xxxx      mirror repository URL for apt packages
--pypi-repository-mirror xxxx     mirror repository URL for pypi packages
--cert-issuer-type xxxx           Issuer for managing SSL certs, choices are my-ca-issuer (default), letsencrypt-staging, letsencrypt-prod
--ssh-key-pub xxxx                public rsa key path, default is ~/.ssh/id_rsa.pub
--backup-server xxxx              External S3 Server (MinIO / AWS S3) URL
--backup-access-key xxxx          S3 Access Key Id
--backup-access-secret xxxx       S3 Access Key Secret
--backup-region xxxx              S3 Bucket Region, default is $BACKUP_REGION
--gitops-repo xxxx                ai-factory git repository url; enables the gitops role when set
--gitops-branch xxxx              ai-factory git branch, default is $GITOPS_BRANCH
--gitops-ssh-key xxxx             private deploy key for the ai-factory repository
--llama-api-key xxxx              api key of the llama-server backing the LLM gateway
--github-token xxxx               GitHub personal access token for the MCP gateway and context graph
--gitlab-backup-passphrase-file xxxx
                                  file holding the passphrase GitLab's off-site rails-secret copies are encrypted with
--minio-admin-credentials-file xxxx
                                  yaml file (accessKey, secretKey) of a MinIO admin, to set up GitLab's off-site store
--ansible-tags xxxx               only run the ansible roles with these tags (comma separated), e.g. on a live cluster
EOF

exit 1
}

# Parse cmd options
while (($# > 0)); do
  case "$1" in
    -c)
      shift
      CNI_PLUGIN="$1"
      shift
      ;;
    --cert-issuer-type)
      shift
      CERTISSUER="$1"
      shift
      ;;
    --ssh-key-pub)
      shift
      SSHKEYFILE="$1"
      shift
      ;;
    --kube-domain)
      shift
      K8S_DOMAIN="$1"
      shift
      ;;
    --container-registry-mirror)
      shift
      MIRROR_REGISTRY="$1"
      shift
      ;;
    --apt-repository-mirror)
      shift
      MIRROR_APT="$1"
      shift
      ;;
    --pypi-repository-mirror)
      shift
      MIRROR_PYPI="$1"
      shift
      ;;
    --failover-ip)
      shift
      VIP_MANAGERS="$1"
      shift
      ;;
    --manager-ips)
      shift
      MANAGER_IPS="$1"
      shift
      ;;
    --node-ips)
      shift
      NODE_IPS="$1"
      shift
      ;;
    --ansible-path)
      shift
      ANSIBLEPATH="$1"
      shift
      ;;
    --backup-server)
      shift
      BACKUP_SERVER_URL="$1"
      shift
      ;;
    --backup-access-key)
      shift
      BACKUP_ACCESS_KEY="$1"
      shift
      ;;
    --backup-access-secret)
      shift
      BACKUP_ACCESS_SECRET="$1"
      shift
      ;;
    --backup-region)
      shift
      BACKUP_REGION="$1"
      shift
      ;;
    --gitops-repo)
      shift
      GITOPS_REPO="$1"
      shift
      ;;
    --gitops-branch)
      shift
      GITOPS_BRANCH="$1"
      shift
      ;;
    --gitops-ssh-key)
      shift
      GITOPS_SSH_KEY="$1"
      shift
      ;;
    --llama-api-key)
      shift
      LLAMA_API_KEY="$1"
      shift
      ;;
    --github-token)
      shift
      GITHUB_TOKEN="$1"
      shift
      ;;
    --gitlab-backup-passphrase-file)
      shift
      GITLAB_BACKUP_PASSPHRASE_FILE="$1"
      shift
      ;;
    --minio-admin-credentials-file)
      shift
      MINIO_ADMIN_CREDENTIALS_FILE="$1"
      shift
      ;;
    --ansible-tags)
      shift
      ANSIBLE_TAGS="$1"
      shift
      ;;
    -h)
      shift
      deployhelp
      ;;
    *)
      shift
      deployhelp
      ;;
  esac
done

if [[ -z "$SSHKEYFILE" ]]; then
  echo "-k ssh key parameter is missing"
  deployhelp
fi

if [[ -z "$VIP_MANAGERS" ]]; then
  echo "-vip1 vip managers ip is missing"
  deployhelp
fi

# Each address lands in the generated Ansible inventory: anything but an IPv4
# address (a space, an empty field) would become a host variable there.
IFS=, read -r -a MANAGER_IP_LIST <<< "$MANAGER_IPS"
IFS=, read -r -a NODE_IP_LIST <<< "$NODE_IPS"
if [[ ${#MANAGER_IP_LIST[@]} -ne 3 || ${#NODE_IP_LIST[@]} -ne 5 ]]; then
  echo "--manager-ips takes 3 addresses and --node-ips 5, comma separated"
  deployhelp
fi
for ip in "$VIP_MANAGERS" "${MANAGER_IP_LIST[@]}" "${NODE_IP_LIST[@]}"; do
  if [[ ! "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo "not an IPv4 address: '$ip'"
    deployhelp
  fi
done

# Check the off-site store's files here, before anything is built. The gitops
# role is the very last thing the playbook runs, so a typo in a path or a
# missing companion flag would otherwise cost a full cluster build to discover.
for offsite_file in "$GITLAB_BACKUP_PASSPHRASE_FILE" "$MINIO_ADMIN_CREDENTIALS_FILE"; do
  if [[ -n "$offsite_file" && ! -r "$offsite_file" ]]; then
    echo "cannot read $offsite_file"
    deployhelp
  fi
done
if [[ -n "$GITLAB_BACKUP_PASSPHRASE_FILE$MINIO_ADMIN_CREDENTIALS_FILE" ]]; then
  if [[ -z "$GITOPS_REPO" || -z "$BACKUP_SERVER_URL" \
        || -z "$GITLAB_BACKUP_PASSPHRASE_FILE" || -z "$MINIO_ADMIN_CREDENTIALS_FILE" ]]; then
    echo "GitLab's off-site store needs --gitops-repo, --backup-server, --gitlab-backup-passphrase-file and --minio-admin-credentials-file together"
    deployhelp
  fi
fi

# Define mirror parameters. An array keeps each -e a single argument, so a value
# carrying a space cannot split into two.
[[ -n "$MIRROR_REGISTRY" ]] && MIRROR_PARAMS+=(-e "crio_mirror=$MIRROR_REGISTRY")

[[ -n "$MIRROR_APT" ]] && MIRROR_PARAMS+=(-e "internal_repos_apt=$MIRROR_APT")

[[ -n "$MIRROR_PYPI" ]] && MIRROR_PARAMS+=(-e "internal_repos_pypi=$MIRROR_PYPI")

# Define gitops parameters. Without --gitops-repo the playbook skips the role.
if [[ -n "$GITOPS_REPO" ]]; then
  GITOPS_PARAMS+=(-e "gitops_repo_url=$GITOPS_REPO" -e "gitops_repo_branch=$GITOPS_BRANCH")
fi
[[ -n "$GITOPS_SSH_KEY" ]] && GITOPS_PARAMS+=(-e "gitops_repo_ssh_key=$GITOPS_SSH_KEY")
[[ -n "$LLAMA_API_KEY" ]] && GITOPS_PARAMS+=(-e "gitops_llama_api_key=$LLAMA_API_KEY")
[[ -n "$GITHUB_TOKEN" ]] && GITOPS_PARAMS+=(-e "gitops_github_token=$GITHUB_TOKEN")
# Only the path travels as an extra var; the passphrase itself never enters argv
# or shell history. Same reason --gitops-ssh-key takes a path rather than a value.
[[ -n "$GITLAB_BACKUP_PASSPHRASE_FILE" ]] && GITOPS_PARAMS+=(-e "gitops_gitlab_backup_passphrase_file=$GITLAB_BACKUP_PASSPHRASE_FILE")
[[ -n "$MINIO_ADMIN_CREDENTIALS_FILE" ]] && GITOPS_PARAMS+=(-e "gitops_minio_admin_credentials_file=$MINIO_ADMIN_CREDENTIALS_FILE")
# A subset of roles, for a live cluster: terraform below finds nothing to change
# on an unchanged cluster, and only the tagged roles run.
[[ -n "$ANSIBLE_TAGS" ]] && ANSIBLE_TAGS_PARAM=(--tags "$ANSIBLE_TAGS")

# Create k8s vms
pushd tf/libvirt > /dev/null

[[ -f terraform.tfvars ]] || cp terraform.tfvars.dist terraform.tfvars

terraform init
terraform apply -auto-approve

sleep 120

popd > /dev/null

# Install Ansible
python3 -mvenv venv
source venv/bin/activate
pip3 install -r requirements.txt

pushd ansible > /dev/null

ln -sf "sizing_vars/sizing_vars_${SIZING}.yml" sizing_vars.yml

# Prepare inventory
cat > tfinventory <<EOF
[man01]
k8s-manager1 ansible_host=${MANAGER_IP_LIST[0]} ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_python_interpreter=/usr/bin/python3 keepalived_state=MASTER keepalived_priority=100
[man02]
k8s-manager2 ansible_host=${MANAGER_IP_LIST[1]} ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_python_interpreter=/usr/bin/python3 keepalived_state=BACKUP keepalived_priority=80
[man03]
k8s-manager3 ansible_host=${MANAGER_IP_LIST[2]} ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_python_interpreter=/usr/bin/python3 keepalived_state=BACKUP keepalived_priority=80

[leader:children]
man01

[managers:children]
man01
man02
man03

[nodes]
k8s-node1 ansible_host=${NODE_IP_LIST[0]} ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_python_interpreter=/usr/bin/python3
k8s-node2 ansible_host=${NODE_IP_LIST[1]} ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_python_interpreter=/usr/bin/python3
k8s-node3 ansible_host=${NODE_IP_LIST[2]} ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_python_interpreter=/usr/bin/python3
k8s-node4 ansible_host=${NODE_IP_LIST[3]} ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_python_interpreter=/usr/bin/python3
k8s-node5 ansible_host=${NODE_IP_LIST[4]} ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_python_interpreter=/usr/bin/python3
EOF

# Disable cowsay ansible output
export ANSIBLE_NOCOWS=1

# Download the Ansible collections
mkdir -p collections/ansible_collections
ansible-galaxy collection install -r requirements.yml -p ./collections/

# Install one K8S manager and two K8S nodes
$ANSIBLEPATH -i tfinventory \
--ssh-extra-args="$SSH_PARAMS" playbook.yml \
-e "global_controlplane_endpoint_ip=$VIP_MANAGERS" -e "cni_plugin=$CNI_PLUGIN" \
-e "keepalived_eth=$VM_ETH" -e "global_domain=$K8S_DOMAIN" -e "global_cert_issuer=$CERTISSUER" \
-e "backup_s3_url=$BACKUP_SERVER_URL" -e "backup_s3_accesskey_id=$BACKUP_ACCESS_KEY" \
-e "backup_s3_accesskey_secret=$BACKUP_ACCESS_SECRET" -e "backup_s3_region=$BACKUP_REGION" \
-e "csi_plugin=$CSI_PLUGIN" -e "global_persistence_disk=true" \
"${MIRROR_PARAMS[@]}" "${GITOPS_PARAMS[@]}" "${ANSIBLE_TAGS_PARAM[@]}"

popd > /dev/null
